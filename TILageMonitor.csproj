<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>TILageMonitor</AssemblyName>
    <RootNamespace>TILageMonitor</RootNamespace>

    <Product>TI-Lage Monitor</Product>
    <Title>TI-Lage Monitor</Title>
    <Description>Überwachung der gematik TI-Lage und TI-Statusinformationen</Description>
    <Company>Randy Carter</Company>
    <Authors>Randy Carter</Authors>
    <Copyright>© 2026 Randy Carter</Copyright>
    <Version>1.0.3</Version>
    <FileVersion>1.0.3.0</FileVersion>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <InformationalVersion>1.0.3</InformationalVersion>

    <ApplicationIcon>TILageMonitor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Unpacked desktop toast activations (Microsoft.Toolkit.Uwp.Notifications) -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TILageMonitor.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
