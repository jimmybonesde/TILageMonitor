<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TILageMonitor</AssemblyName>
    <RootNamespace>TILageMonitor</RootNamespace>
    <Product>TI-Lage Monitor</Product>
    <Title>TI-Lage Monitor</Title>
    <Description>Überwachung der gematik TI-Lage und TI-Statusinformationen</Description>
    <Company>Randy Carter</Company>
    <Authors>Randy Carter</Authors>
    <Copyright>© 2026 Randy Carter</Copyright>
    <Version>1.0.7</Version>
    <FileVersion>1.0.7.0</FileVersion>
    <AssemblyVersion>1.0.7.0</AssemblyVersion>
    <InformationalVersion>1.0.7</InformationalVersion>
    <ApplicationIcon>TILageMonitor.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="TILageMonitor.ico" />
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
  <Target Name="CopyIconBesideOutput" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\TILageMonitor.ico"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\TILageMonitor.ico')" />
  </Target>
  <Target Name="CopyIconToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\TILageMonitor.ico"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\TILageMonitor.ico')" />
  </Target>
</Project>
