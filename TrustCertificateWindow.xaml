<Window x:Class="TILageMonitor.TrustCertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konnektor-Zertifikat prüfen"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="False">
    <Border Margin="20" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1" CornerRadius="16" Padding="20">
        <StackPanel>
            <TextBlock x:Name="HeadlineText" Text="Konnektor-Zertifikat prüfen" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMain}" Margin="0,0,0,8"/>
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,0,0,14"
                       Text="Bitte den SHA-256-Fingerprint mit der Anzeige in der Konnektor-Administration vergleichen. Erst nach Bestätigung werden Daten abgefragt."/>
            <TextBlock Text="SHA-256-Fingerprint" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
            <TextBox x:Name="FingerprintBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                     Style="{StaticResource ThemeAwareTextBoxStyle}" Margin="0,4,0,12"/>
            <TextBlock Text="Antragsteller" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
            <TextBlock x:Name="SubjectText" TextWrapping="Wrap" Foreground="{DynamicResource TextMain}" Margin="0,2,0,10"/>
            <TextBlock Text="Aussteller" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
            <TextBlock x:Name="IssuerText" TextWrapping="Wrap" Foreground="{DynamicResource TextMain}" Margin="0,2,0,10"/>
            <TextBlock Text="Gültigkeit" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
            <TextBlock x:Name="ValidityText" TextWrapping="Wrap" Foreground="{DynamicResource TextMain}" Margin="0,2,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Padding="16,9" Margin="0,0,8,0" MinWidth="110" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Vertrauen" Style="{StaticResource AccentButtonStyle}" Padding="16,9" MinWidth="110" Click="Trust_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
