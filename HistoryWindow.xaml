<Window x:Class="TILageMonitor.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TI-Status · 7 Tage"
        Width="960"
        Height="560"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="HistoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="HourCellStyle" TargetType="Border">
            <Setter Property="Height" Value="15"/>
            <Setter Property="Margin" Value="0.5"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="ZoomHourCellStyle" TargetType="Border">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="TI-Status · 7 Tage"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMain}"/>
            <TextBlock x:Name="HeaderHint"
                       Text="Stündliche Auflösung über die letzten 7 lokalen Kalendertage (baut sich mit der Laufzeit auf). Tag anklicken zum Zoomen."
                       FontSize="13"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- Overview: 7 days -->
            <Grid x:Name="OverviewPanel">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="880">
                        <ItemsControl x:Name="HistoryList" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HistoryCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding ServiceName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMain}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,8,0"/>

                                            <ItemsControl Grid.Column="1"
                                                          ItemsSource="{Binding Days}"
                                                          HorizontalAlignment="Stretch">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="7"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Cursor="Hand"
                                                                Background="Transparent"
                                                                Padding="0"
                                                                MouseLeftButtonUp="DayColumn_MouseLeftButtonUp"
                                                                ToolTip="Tag vergrößern">
                                                            <StackPanel Margin="3,0">
                                                                <TextBlock Text="{Binding Label}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextMuted}"
                                                                           HorizontalAlignment="Center"
                                                                           Margin="0,0,0,4"
                                                                           Cursor="Hand"/>
                                                                <ItemsControl ItemsSource="{Binding Hours}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Rows="1" Columns="24"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Style="{StaticResource HourCellStyle}"
                                                                                    Background="{Binding CellBrush}"
                                                                                    ToolTip="{Binding Tooltip}"/>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="NoHistoryBorder"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,10"
                                Visibility="Collapsed">
                            <TextBlock Text="Keine Verlaufsdaten"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Zoom: single day, 24 hours -->
            <Grid x:Name="ZoomPanel" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <StackPanel MinWidth="880">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="← Alle 7 Tage"
                                    Click="ExitZoom_Click"
                                    Padding="12,6"
                                    MinWidth="120"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="ZoomTitle"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"/>
                        </StackPanel>

                        <!-- Hour axis -->
                        <Border Style="{StaticResource HistoryCardStyle}" Padding="14,8" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stunde"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <ItemsControl x:Name="ZoomHourAxis" Grid.Column="1">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="24"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       HorizontalAlignment="Center"
                                                       Margin="1,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="ZoomList" Margin="0,0,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HistoryCardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding ServiceName}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMain}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,8,0"/>

                                            <ItemsControl Grid.Column="1"
                                                          ItemsSource="{Binding Hours}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="24"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ZoomHourCellStyle}"
                                                                Background="{Binding CellBrush}"
                                                                ToolTip="{Binding Tooltip}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <Border x:Name="LegendOk" Width="12" Height="12" CornerRadius="2" Background="#228B22" VerticalAlignment="Center"/>
                <TextBlock Text="OK" Margin="6,0,0,0" FontSize="11"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <Border x:Name="LegendPartial" Width="12" Height="12" CornerRadius="2" Background="#FF8C00" VerticalAlignment="Center"/>
                <TextBlock Text="Einschränkung" Margin="6,0,0,0" FontSize="11"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <Border x:Name="LegendFull" Width="12" Height="12" CornerRadius="2" Background="#B22222" VerticalAlignment="Center"/>
                <TextBlock Text="Störung" Margin="6,0,0,0" FontSize="11"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="LegendEmpty" Width="12" Height="12" CornerRadius="2" Background="#CBD5E1" VerticalAlignment="Center"/>
                <TextBlock Text="keine Daten" Margin="6,0,0,0" FontSize="11"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Schließen"
                    HorizontalAlignment="Right"
                    MinWidth="110"
                    Click="Close_Click"
                    Padding="16,10"/>
        </Grid>
    </Grid>
</Window>
