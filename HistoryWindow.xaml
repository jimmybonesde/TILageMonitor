<Window x:Class="TILageMonitor.HistoryWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="TI-Status · 7 Tage"
  Width="960"
  Height="560"
  MinWidth="720"
  MinHeight="420"
  WindowStartupLocation="CenterOwner"
  ResizeMode="CanResizeWithGrip"
  Background="{DynamicResource WindowBackground}"
  ShowInTaskbar="False"
  Focusable="True">
    <Window.Resources>
  <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
  </Style>
  <Style x:Key="SectionHintStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="HistoryCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="HourCellStyle" TargetType="Border">
      <Setter Property="Height" Value="15"/>
      <Setter Property="Margin" Value="0.5"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="ZoomHourCellStyle" TargetType="Border">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
    </Window.Resources>
    <Grid Margin="24">
  <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <DockPanel LastChildFill="True">
    <TextBlock x:Name="CoverageHint"
         DockPanel.Dock="Right"
         Text="0 / 168 Stunden erfasst"
         FontSize="12"
         Foreground="{DynamicResource TextMuted}"
         VerticalAlignment="Bottom"
         Margin="12,0,0,2"/>
    <TextBlock Text="TI-Status · 7 Tage"
         FontSize="24"
         FontWeight="SemiBold"
         Foreground="{DynamicResource TextMain}"/>
      </DockPanel>
      <TextBlock x:Name="HeaderHint"
           Text="Stündliche Auflösung über die letzten 7 lokalen Kalendertage (baut sich mit der Laufzeit auf). Tag anklicken zum Zoomen."
           FontSize="13"
           Foreground="{DynamicResource TextMuted}"
           Margin="0,4,0,0"
           TextWrapping="Wrap"/>
  </StackPanel>
  <Grid Grid.Row="1">
      <!-- Overview: 7 days -->
      <Grid x:Name="OverviewPanel">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto">
        <StackPanel MinWidth="880">
      <!-- Subtle hour marks 0 / 6 / 12 / 18 per day column -->
      <Border x:Name="OverviewHourAxisCard"
        Style="{StaticResource HistoryCardStyle}"
        Padding="14,6"
        Margin="0,0,0,4"
        Visibility="Collapsed">
          <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Stunde"
             FontSize="10"
             Foreground="{DynamicResource TextMuted}"
             VerticalAlignment="Center"/>
        <ItemsControl x:Name="OverviewHourAxis" Grid.Column="1">
            <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
              <UniformGrid Rows="1" Columns="7"/>
          </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
          <DataTemplate>
              <ItemsControl ItemsSource="{Binding}" Margin="3,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
              <UniformGrid Rows="1" Columns="24"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
              <TextBlock Text="{Binding}"
                   FontSize="9"
                   Foreground="{DynamicResource TextMuted}"
                   HorizontalAlignment="Center"
                   Opacity="0.85"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
              </ItemsControl>
          </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
          </Grid>
      </Border>
      <ItemsControl x:Name="HistoryList" Margin="0,0,0,4" Visibility="Collapsed">
          <ItemsControl.ItemTemplate>
        <DataTemplate>
            <Border Style="{StaticResource HistoryCardStyle}">
          <Grid>
              <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding ServiceName}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMain}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,8,0"/>
              <ItemsControl Grid.Column="1"
                ItemsSource="{Binding Days}"
                HorizontalAlignment="Stretch">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
              <UniformGrid Rows="1" Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
              <Border Cursor="Hand"
                Background="Transparent"
                Padding="0"
                MouseLeftButtonUp="DayColumn_MouseLeftButtonUp"
                ToolTip="Tag vergrößern">
                  <StackPanel Margin="3,0">
                <TextBlock Text="{Binding Label}"
                     FontSize="10"
                     Foreground="{DynamicResource TextMuted}"
                     HorizontalAlignment="Center"
                     Margin="0,0,0,4"
                     Cursor="Hand"/>
                <ItemsControl ItemsSource="{Binding Hours}">
                    <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                      <UniformGrid Rows="1" Columns="24"/>
                  </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                  <DataTemplate>
                      <Border Style="{StaticResource HourCellStyle}"
                        Background="{Binding CellBrush}"
                        ToolTip="{Binding Tooltip}"/>
                  </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                  </StackPanel>
              </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
              </ItemsControl>
          </Grid>
            </Border>
        </DataTemplate>
          </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border x:Name="NoHistoryBorder"
        Background="{DynamicResource CardBackground}"
        BorderBrush="{DynamicResource BorderSubtle}"
        BorderThickness="1"
        CornerRadius="14"
        Padding="28,36"
        Margin="0,0,0,10"
        Visibility="Visible">
          <StackPanel HorizontalAlignment="Center" MaxWidth="420">
        <TextBlock Text="Keine Verlaufsdaten"
             FontSize="16"
             FontWeight="SemiBold"
             Foreground="{DynamicResource TextMain}"
             HorizontalAlignment="Center"
             Margin="0,0,0,8"/>
        <TextBlock Text="Der 7-Tage-Verlauf baut sich auf, sobald die App läuft und Statusdaten erfasst. Es gibt noch keine gespeicherten Stunden."
             FontSize="13"
             Foreground="{DynamicResource TextMuted}"
             TextWrapping="Wrap"
             TextAlignment="Center"
             HorizontalAlignment="Center"/>
          </StackPanel>
      </Border>
        </StackPanel>
    </ScrollViewer>
      </Grid>
      <!-- Zoom: single day, 24 hours -->
      <Grid x:Name="ZoomPanel" Visibility="Collapsed">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto">
        <StackPanel MinWidth="880">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
          <Button Content="← Alle 7 Tage"
            Click="ExitZoom_Click"
            Padding="12,6"
            MinWidth="120"
            VerticalAlignment="Center"/>
          <TextBlock x:Name="ZoomTitle"
               FontSize="16"
               FontWeight="SemiBold"
               Foreground="{DynamicResource TextMain}"
               VerticalAlignment="Center"
               Margin="16,0,0,0"/>
      </StackPanel>
      <!-- Hour axis -->
      <Border Style="{StaticResource HistoryCardStyle}" Padding="14,8" Margin="0,0,0,4">
          <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Stunde"
             FontSize="11"
             Foreground="{DynamicResource TextMuted}"
             VerticalAlignment="Center"/>
        <ItemsControl x:Name="ZoomHourAxis" Grid.Column="1">
            <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
              <UniformGrid Rows="1" Columns="24"/>
          </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
          <DataTemplate>
              <TextBlock Text="{Binding}"
                   FontSize="10"
                   Foreground="{DynamicResource TextMuted}"
                   HorizontalAlignment="Center"
                   Margin="1,0"/>
          </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
          </Grid>
      </Border>
      <ItemsControl x:Name="ZoomList" Margin="0,0,0,4">
          <ItemsControl.ItemTemplate>
        <DataTemplate>
            <Border Style="{StaticResource HistoryCardStyle}">
          <Grid>
              <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding ServiceName}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMain}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,8,0"/>
              <ItemsControl Grid.Column="1"
                ItemsSource="{Binding Hours}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
              <UniformGrid Rows="1" Columns="24"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
              <Border Style="{StaticResource ZoomHourCellStyle}"
                Background="{Binding CellBrush}"
                ToolTip="{Binding Tooltip}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
              </ItemsControl>
          </Grid>
            </Border>
        </DataTemplate>
          </ItemsControl.ItemTemplate>
      </ItemsControl>
        </StackPanel>
    </ScrollViewer>
      </Grid>
  </Grid>
  <StackPanel x:Name="LegendPanel"
        Grid.Row="2"
        Orientation="Horizontal"
        Margin="0,10,0,0"
        HorizontalAlignment="Left"
        Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
    <Border x:Name="LegendOk" Width="12" Height="12" CornerRadius="2"
      Background="{DynamicResource StatusOk}" VerticalAlignment="Center"/>
    <TextBlock Text="OK" Margin="6,0,0,0" FontSize="11"
         Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
    <Border x:Name="LegendPartial" Width="12" Height="12" CornerRadius="2"
      Background="{DynamicResource StatusPartial}" VerticalAlignment="Center"/>
    <TextBlock Text="Einschränkung" Margin="6,0,0,0" FontSize="11"
         Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
    <Border x:Name="LegendMaintenance" Width="12" Height="12" CornerRadius="2"
      Background="{DynamicResource StatusMaintenance}" VerticalAlignment="Center"/>
    <TextBlock Text="Wartung" Margin="6,0,0,0" FontSize="11"
         Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
    <Border x:Name="LegendFull" Width="12" Height="12" CornerRadius="2"
      Background="{DynamicResource StatusOutage}" VerticalAlignment="Center"/>
    <TextBlock Text="Störung" Margin="6,0,0,0" FontSize="11"
         Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
    <Border x:Name="LegendEmpty" Width="12" Height="12" CornerRadius="2" Background="#CBD5E1" VerticalAlignment="Center"/>
    <TextBlock Text="keine Daten" Margin="6,0,0,0" FontSize="11"
         Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
      </StackPanel>
  </StackPanel>
  <Grid Grid.Row="3" Margin="0,12,0,0">
      <Button Content="Schließen"
        HorizontalAlignment="Right"
        MinWidth="110"
        Click="Close_Click"
        Padding="16,10"/>
  </Grid>
    </Grid>
</Window>
