<Window x:Class="TILageMonitor.HistoryWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="TI-Status · 14 Tage"
  Width="1040"
  Height="680"
  MinWidth="800"
  MinHeight="500"
  WindowState="Maximized"
  WindowStartupLocation="CenterScreen"
  ResizeMode="CanResizeWithGrip"
  Background="{DynamicResource WindowBackground}"
  ShowInTaskbar="True"
  Focusable="True">
  <Window.Resources>
    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="SectionHintStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="HistoryCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="KpiCardStyle" TargetType="Border">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="MinHeight" Value="88"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="DayTileStyle" TargetType="Border">
      <Setter Property="Margin" Value="3"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
      <Setter Property="Padding" Value="6,8"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="ZoomHourCellStyle" TargetType="Border">
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="1.5"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="TimelineItemStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="SegmentButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinWidth" Value="110"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="TimelineEventTemplate">
      <Border MouseLeftButtonUp="TimelineEvent_MouseLeftButtonUp"
              ToolTip="{Binding ClickHint}">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource TimelineItemStyle}">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
                <Setter Property="BorderThickness" Value="2"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border.Effect>
          <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08" Direction="270" Color="#000000"/>
        </Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0"
                  Background="{Binding AccentBarBrush}"
                  CornerRadius="14,0,0,14"/>
          <StackPanel Grid.Column="1" Margin="14,12,10,12">
            <TextBlock Text="{Binding Title}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMain}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding TimeRangeText}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Body}"
                       FontSize="12"
                       Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
          </StackPanel>
          <TextBlock Grid.Column="2"
                     Text="→"
                     FontSize="14"
                     Foreground="{DynamicResource TextMuted}"
                     VerticalAlignment="Center"
                     Margin="0,0,14,0"/>
        </Grid>
      </Border>
    </DataTemplate>

  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <DockPanel LastChildFill="True">
        <TextBlock x:Name="CoverageHint"
                   DockPanel.Dock="Right"
                   Text="0 / 336 Stunden erfasst"
                   FontSize="12"
                   Foreground="{DynamicResource TextMuted}"
                   VerticalAlignment="Bottom"
                   Margin="12,0,0,2"/>
        <TextBlock Text="TI-Status · 14 Tage"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMain}"/>
      </DockPanel>
      <TextBlock x:Name="HeaderHint"
                 Text="Tageskacheln in der Übersicht, Stunden-Zoom und Ereignisse als eigene Ansichten."
                 FontSize="13"
                 Foreground="{DynamicResource TextMuted}"
                 Margin="0,4,0,0"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <!-- KPI cards -->
    <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
      <Border x:Name="KpiTodayCard" Style="{StaticResource KpiCardStyle}"
              Background="{DynamicResource StatusOkSurface}"
              BorderBrush="{DynamicResource StatusOkBorder}"
              Margin="0,0,10,0">
        <Border.Effect>
          <DropShadowEffect x:Name="KpiShadow1" BlurRadius="14" ShadowDepth="2" Opacity="0.10" Direction="270" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="Heute" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMuted}"/>
          <TextBlock x:Name="KpiTodayValue" Text="Alles OK" FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMain}" Margin="0,6,0,0"/>
          <TextBlock x:Name="KpiTodayHint" Text="Schlechtester Status heute"
                     FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border x:Name="KpiDaysCard" Style="{StaticResource KpiCardStyle}"
              Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderSubtle}"
              Margin="5,0,5,0">
        <Border.Effect>
          <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10" Direction="270" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="14 Tage" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMuted}"/>
          <TextBlock x:Name="KpiDaysValue" Text="0 auffällige Tage" FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMain}" Margin="0,6,0,0"/>
          <TextBlock x:Name="KpiDaysHint" Text="Tage mit Einschränkung, Störung oder Wartung"
                     FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border x:Name="KpiAvailCard" Style="{StaticResource KpiCardStyle}"
              Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderSubtle}"
              Margin="10,0,0,0">
        <Border.Effect>
          <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.10" Direction="270" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock Text="Verfügbarkeit" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMuted}"/>
          <TextBlock x:Name="KpiAvailValue" Text="—" FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextMain}" Margin="0,6,0,0"/>
          <TextBlock x:Name="KpiAvailHint" Text="Lokal erfasste / API-gefüllte Stunden (ohne Zukunft)"
                     FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Segmented control + service chips -->
    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <Border Background="{DynamicResource ChipBackground}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="4"
              HorizontalAlignment="Left"
              Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="SegOverview" Content="Übersicht"
                  Style="{StaticResource SegmentButtonStyle}"
                  Click="Segment_Click" Tag="Overview"/>
          <Button x:Name="SegHours" Content="Stunden"
                  Style="{StaticResource SegmentButtonStyle}"
                  Click="Segment_Click" Tag="Hours"/>
          <Button x:Name="SegEvents" Content="Ereignisse"
                  Style="{StaticResource SegmentButtonStyle}"
                  Click="Segment_Click" Tag="Events"/>
        </StackPanel>
      </Border>
      <DockPanel LastChildFill="True">
        <Button x:Name="AllServicesButton"
                DockPanel.Dock="Right"
                Content="Alle Dienste"
                Click="AllServices_Click"
                Padding="12,6"
                FontSize="12"
                Margin="12,0,0,8"
                VerticalAlignment="Center"
                ToolTip="Alle Dienste nebeneinander anzeigen"/>
        <WrapPanel x:Name="ServiceFilterPanel"
                   Orientation="Horizontal"
                   VerticalAlignment="Center"/>
      </DockPanel>
    </StackPanel>

    <!-- Main content: three soft-switched panels -->
    <Grid Grid.Row="3">
      <!-- OVERVIEW -->
      <Grid x:Name="OverviewPanel" Opacity="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <!-- Stabil / Alles ruhig -->
            <Border x:Name="StableOkBorder"
                    Background="{DynamicResource StatusOkSurface}"
                    BorderBrush="{DynamicResource StatusOkBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20,16"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
              <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.08" Direction="270" Color="#000000"/>
              </Border.Effect>
              <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="22"
                        Background="{DynamicResource ChipBackground}"
                        VerticalAlignment="Center" Margin="0,0,14,0">
                  <TextBlock Text="✓" FontSize="20" FontWeight="Bold"
                             Foreground="{DynamicResource StatusOk}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="StableOkTitle" Text="Stabil · Alles ruhig"
                             FontSize="16" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMain}"/>
                  <TextBlock x:Name="StableOkSubtitle"
                             Text="In den letzten 14 Tagen gab es für diesen Fokus keine Einschränkungen oder Störungen."
                             FontSize="13" Foreground="{DynamicResource TextMuted}"
                             TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Focus: day tiles only (Ereignisse live in the Events segment) -->
            <Grid x:Name="FocusOverviewGrid" Visibility="Collapsed">
              <Border Style="{StaticResource HistoryCardStyle}" Margin="0">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.10" Direction="270" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Tagesübersicht"/>
                  <TextBlock Style="{StaticResource SectionHintStyle}"
                             Text="Große Tageskacheln — Farbe = schlechtester Status. Auswahl und Klick öffnen Stunden."/>
                  <ItemsControl x:Name="FocusHistoryList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Days}" Margin="0,4,0,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Rows="2" Columns="7"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="{Binding DayBrush}"
                                      MouseLeftButtonUp="DayColumn_MouseLeftButtonUp"
                                      ToolTip="{Binding DayTooltip}"
                                      MinHeight="72">
                                <Border.Style>
                                  <Style TargetType="Border" BasedOn="{StaticResource DayTileStyle}">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                  <TextBlock Text="{Binding WeekdayAbbrev}" FontSize="11" FontWeight="SemiBold"
                                             Foreground="{Binding DayForeground}" HorizontalAlignment="Center" Opacity="0.92"/>
                                  <TextBlock Text="{Binding DateLabel}" FontSize="15" FontWeight="Bold"
                                             Foreground="{Binding DayForeground}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>

            <!-- Alle: stacked compact rows + timeline below -->
            <StackPanel x:Name="MultiOverviewPanel" Visibility="Collapsed">
              <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Alle Dienste"/>
              <TextBlock Style="{StaticResource SectionHintStyle}"
                         Text="Kompakte Zeilen je Dienst. Ein Dienst-Chip oben fokussiert die Tageskacheln; Ereignisse über den Segment-Umschalter."/>
              <ItemsControl x:Name="HistoryList" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource HistoryCardStyle}" Padding="{Binding CardPadding}">
                      <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.08" Direction="270" Color="#000000"/>
                      </Border.Effect>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="120"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ServiceName}"
                                   FontSize="{Binding ServiceLabelFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,10,0"/>
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid Rows="1" Columns="14"/>
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Background="{Binding DayBrush}"
                                      MouseLeftButtonUp="DayColumn_MouseLeftButtonUp"
                                      ToolTip="{Binding DayTooltip}"
                                      MinHeight="52">
                                <Border.Style>
                                  <Style TargetType="Border" BasedOn="{StaticResource DayTileStyle}">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
                                        <Setter Property="BorderThickness" Value="2.5"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                  <TextBlock Text="{Binding WeekdayAbbrev}" FontSize="10" FontWeight="SemiBold"
                                             Foreground="{Binding DayForeground}" HorizontalAlignment="Center" Opacity="0.9"/>
                                  <TextBlock Text="{Binding DateLabel}" FontSize="12" FontWeight="Bold"
                                             Foreground="{Binding DayForeground}" HorizontalAlignment="Center"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>

            <!-- No data empty -->
            <Border x:Name="NoHistoryBorder"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28,40"
                    Margin="0,0,0,12"
                    Visibility="Visible">
              <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.10" Direction="270" Color="#000000"/>
              </Border.Effect>
              <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                <Border Width="56" Height="56" CornerRadius="28"
                        Background="{DynamicResource ChipBackground}"
                        HorizontalAlignment="Center" Margin="0,0,0,14">
                  <TextBlock Text="◌" FontSize="26" FontWeight="Light"
                             Foreground="{DynamicResource TextMuted}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="NoHistoryTitle"
                           Text="Noch keine Verlaufsdaten"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="NoHistorySubtitle"
                           Text="Der 14-Tage-Verlauf kombiniert gematik-API-Daten mit lokal erfassten Stunden. Sobald die App aktualisiert, füllen sich die Kacheln ruhig von selbst."
                           FontSize="13"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- STUNDEN / ZOOM -->
      <Grid x:Name="ZoomPanel" Visibility="Collapsed" Opacity="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <StackPanel MinWidth="900">
            <Border x:Name="ZoomHintBorder"
                    Background="{DynamicResource ChipBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,16"
                    Margin="0,0,0,14"
                    Visibility="Collapsed">
              <TextBlock x:Name="ZoomHintText"
                         Text="Bitte wählen Sie in der Übersicht einen Tag — oder es wird automatisch heute genutzt."
                         FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Button Content="← Zurück zur Übersicht"
                      Click="ExitZoom_Click"
                      Padding="14,8"
                      MinWidth="160"
                      VerticalAlignment="Center"/>
              <TextBlock x:Name="ZoomTitle"
                         FontSize="18"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextMain}"
                         VerticalAlignment="Center"
                         Margin="18,0,0,0"/>
            </StackPanel>
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Stundenansicht (0–23)"/>
            <TextBlock Style="{StaticResource SectionHintStyle}"
                       Text="Klick auf eine auffällige Stunde öffnet das passende Ereignis. Esc oder Zurück kehrt zur Übersicht."/>

            <Border Style="{StaticResource HistoryCardStyle}" Padding="14,10" Margin="0,0,0,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stunde"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center"/>
                <ItemsControl x:Name="ZoomHourAxis" Grid.Column="1">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Rows="1" Columns="24"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextMuted}"
                                 HorizontalAlignment="Center"
                                 Margin="1,0"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>
            <ItemsControl x:Name="ZoomList" Margin="0,0,0,4">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource HistoryCardStyle}" Padding="16,14">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding ServiceName}"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextMain}"
                                 VerticalAlignment="Center"
                                 TextWrapping="Wrap"
                                 Margin="0,0,10,0"/>
                      <ItemsControl Grid.Column="1" ItemsSource="{Binding Hours}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="24"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource ZoomHourCellStyle}"
                                    Background="{Binding CellBrush}"
                                    ToolTip="{Binding Tooltip}"
                                    Cursor="{Binding CellCursor}"
                                    MouseLeftButtonUp="ZoomHourCell_MouseLeftButtonUp"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- EREIGNISSE full-width -->
      <Grid x:Name="EventsPanel" Visibility="Collapsed" Opacity="0">
        <ScrollViewer x:Name="EventsScrollViewer" VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource HistoryCardStyle}" Margin="0">
            <Border.Effect>
              <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.10" Direction="270" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Ereignisse"/>
              <TextBlock Style="{StaticResource SectionHintStyle}"
                         Text="Vollständige Timeline. Klick auf eine Karte öffnet die Stundenansicht für den Starttag."/>
              <ItemsControl x:Name="EventsTimelineList" ItemTemplate="{StaticResource TimelineEventTemplate}"/>
              <Border x:Name="EventsEmptyCard"
                      Background="{DynamicResource StatusOkSurface}"
                      BorderBrush="{DynamicResource StatusOkBorder}"
                      BorderThickness="1"
                      CornerRadius="14"
                      Padding="18,16"
                      Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="Alles ruhig" FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMain}"/>
                  <TextBlock Text="Im gewählten Fokus gibt es im 14-Tage-Fenster keine gemeldeten Ereignisse."
                             FontSize="13" Foreground="{DynamicResource TextMuted}"
                             TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- Legend -->
    <Border x:Name="LegendPanel"
            Grid.Row="4"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="14,10"
            Margin="0,12,0,0"
            Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <TextBlock Text="Legende"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMain}"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
          <Border x:Name="LegendOk" Width="14" Height="14" CornerRadius="3"
                  Background="{DynamicResource StatusOk}" VerticalAlignment="Center"/>
          <TextBlock Text="OK" Margin="6,0,0,0" FontSize="12"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
          <Border x:Name="LegendPartial" Width="14" Height="14" CornerRadius="3"
                  Background="{DynamicResource StatusPartial}" VerticalAlignment="Center"/>
          <TextBlock Text="Einschränkung" Margin="6,0,0,0" FontSize="12"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
          <Border x:Name="LegendMaintenance" Width="14" Height="14" CornerRadius="3"
                  Background="{DynamicResource StatusMaintenance}" VerticalAlignment="Center"/>
          <TextBlock Text="Wartung" Margin="6,0,0,0" FontSize="12"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
          <Border x:Name="LegendFull" Width="14" Height="14" CornerRadius="3"
                  Background="{DynamicResource StatusOutage}" VerticalAlignment="Center"/>
          <TextBlock Text="Störung" Margin="6,0,0,0" FontSize="12"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border x:Name="LegendEmpty" Width="14" Height="14" CornerRadius="3"
                  Background="{DynamicResource StatusEmpty}" VerticalAlignment="Center"/>
          <TextBlock Text="keine Daten" Margin="6,0,0,0" FontSize="12"
                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="5" Margin="0,12,0,0">
      <Button Content="Schließen"
              HorizontalAlignment="Right"
              MinWidth="110"
              Click="Close_Click"
              Padding="16,10"/>
    </Grid>
  </Grid>
</Window>
