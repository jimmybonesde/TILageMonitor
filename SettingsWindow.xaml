<Window x:Class="TILageMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="643"
        Height="908"
        MinWidth="555"
        MinHeight="756"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Einstellungen"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMain}"/>
            <TextBlock Text="Darstellung, Startverhalten, Updates, Konnektor und Benachrichtigungen"
                       FontSize="13"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Sprache -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Sprache" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Sprache der Oberfläche auswählen"
                                   Style="{StaticResource SectionHintStyle}"/>
                        <RadioButton x:Name="LanguageSystemToggle"
                                     Content="Automatisch (Windows-Systemsprache)"
                                     GroupName="UiLanguage"
                                     Foreground="{DynamicResource TextMain}"
                                     Margin="0,0,0,7"
                                     Checked="Language_Changed"/>
                        <RadioButton x:Name="LanguageGermanToggle"
                                     Content="Deutsch"
                                     GroupName="UiLanguage"
                                     Foreground="{DynamicResource TextMain}"
                                     Margin="0,0,0,7"
                                     Checked="Language_Changed"/>
                        <RadioButton x:Name="LanguageEnglishToggle"
                                     Content="English"
                                     GroupName="UiLanguage"
                                     Foreground="{DynamicResource TextMain}"
                                     Checked="Language_Changed"/>
                        <TextBlock x:Name="LanguageRestartHint"
                                   Text="Die Auswahl wird nach einem Neustart der App übernommen."
                                   Style="{StaticResource SectionHintStyle}"
                                   Margin="0,10,0,8"/>
                        <Button x:Name="RestartForLanguageButton"
                                Content="Jetzt neu starten"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="16,9"
                                Visibility="Collapsed"
                                Click="RestartForLanguage_Click"/>
                    </StackPanel>
                </Border>

                <!-- Darstellung -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Darstellung" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Oberfläche der Anwendung"
                                   Style="{StaticResource SectionHintStyle}"/>
                        <CheckBox x:Name="DarkModeToggle"
                                  Content="Dunkelmodus"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Checked="DarkModeToggle_Changed"
                                  Unchecked="DarkModeToggle_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Start -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Start" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Beim Anmelden automatisch starten (mit --tray)"
                                   Style="{StaticResource SectionHintStyle}"/>
                        <CheckBox x:Name="AutoStartToggle"
                                  Content="Autostart"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Checked="AutoStartToggle_Changed"
                                  Unchecked="AutoStartToggle_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Beim Start wird automatisch nach einer neuen Version gesucht."
                                   Style="{StaticResource SectionHintStyle}"/>
                        <CheckBox x:Name="AutoInstallUpdatesToggle"
                                  Content="Updates automatisch installieren"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Margin="0,0,0,8"
                                  Checked="AutoInstallUpdatesToggle_Changed"
                                  Unchecked="AutoInstallUpdatesToggle_Changed"/>
                        <TextBlock Text="Neue Releases werden heruntergeladen, per SHA-256 geprüft und nach dem Beenden der App ohne Assistent installiert."
                                   Style="{StaticResource SectionHintStyle}"
                                   Margin="0,0,0,10"/>
                        <TextBlock x:Name="UpdateStatusText"
                                   Text="Aktuelle Version wird beim Start automatisch geprüft."
                                   Style="{StaticResource SectionHintStyle}"
                                   Margin="0,0,0,10"/>
                        <Button x:Name="CheckForUpdatesButton"
                                Content="Nach Updates suchen"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="16,9"
                                Click="CheckForUpdates_Click"/>
                    </StackPanel>
                </Border>

                <!-- Konnektor (lokal, read-only) -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Konnektor" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Lokalen TI-Konnektor (RISE, secunet, KoCoBox) nur lesend abfragen: Erreichbarkeit, VPN, Karten, PIN-Status, Kartenterminals."
                                   Style="{StaticResource SectionHintStyle}"/>
                        <CheckBox x:Name="KonnektorEnabledToggle"
                                  Content="Konnektor regelmäßig prüfen"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="IP / Hostname" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="KonnektorHostBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource ThemeAwareTextBoxStyle}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="Port" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="KonnektorPortBox" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" Style="{StaticResource ThemeAwareTextBoxStyle}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Text="MandantId" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="KonnektorMandantBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource ThemeAwareTextBoxStyle}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Text="ClientSystemId" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="KonnektorClientSystemBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource ThemeAwareTextBoxStyle}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="4" Text="WorkplaceId" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="KonnektorWorkplaceBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource ThemeAwareTextBoxStyle}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="5" Text="UserId (optional)" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="KonnektorUserBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource ThemeAwareTextBoxStyle}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="6" Text="Prüfintervall (Min.)" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox x:Name="KonnektorIntervalBox" Grid.Row="6" Grid.Column="1" Width="90" HorizontalAlignment="Left" Style="{StaticResource ThemeAwareTextBoxStyle}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="7" Text="Clientzertifikat (.p12)" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="KonnektorImportP12Button" Content="P12 auswählen …" Padding="12,6" Click="KonnektorImportP12_Click"/>
                                <TextBlock x:Name="KonnektorP12StatusText" Text="Kein Zertifikat hinterlegt" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Row="8" Text="P12-Passwort" Foreground="{DynamicResource TextMain}" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <PasswordBox x:Name="KonnektorPasswordBox" Grid.Row="8" Grid.Column="1" Style="{StaticResource ThemeAwarePasswordBoxStyle}" Margin="0,0,0,8"/>
                        </Grid>
                        <TextBlock Text="Zertifikat und Passwort werden nur mit Windows-DPAPI (aktueller Benutzer) verschlüsselt gespeichert."
                                   Style="{StaticResource SectionHintStyle}" Margin="0,4,0,8"/>
                        <TextBlock x:Name="KonnektorPinText" Style="{StaticResource SectionHintStyle}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="KonnektorStatusText" Style="{StaticResource SectionHintStyle}" Margin="0,0,0,10"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="KonnektorSaveButton" Content="Speichern" Padding="14,8" Margin="0,0,8,8" Click="KonnektorSave_Click"/>
                            <Button x:Name="KonnektorTestButton" Content="Verbindung testen" Style="{StaticResource AccentButtonStyle}" Padding="14,8" Margin="0,0,8,8" Click="KonnektorTest_Click"/>
                            <Button Content="Vertrauen zurücksetzen" Padding="14,8" Margin="0,0,8,8" Click="KonnektorResetTrust_Click"/>
                            <Button Content="Konnektor-Daten löschen" Padding="14,8" Margin="0,0,8,8" Click="KonnektorDelete_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Benachrichtigungen -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Benachrichtigungen" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Toast-Meldungen pro Dienst (Tray-Icon-Farbe bleibt unverändert)"
                                   Style="{StaticResource SectionHintStyle}"/>
                        <CheckBox x:Name="NotificationsMasterToggle"
                                  Content="Benachrichtigungen aktiviert"
                                  Style="{DynamicResource ThemeAwareCheckBoxStyle}"
                                  Margin="0,0,0,10"
                                  Checked="NotificationsMaster_Changed"
                                  Unchecked="NotificationsMaster_Changed"/>
                        <TextBlock Text="Pro Dienst"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,0,0,6"/>
                        <WrapPanel x:Name="NotifyServicesPanel" Orientation="Horizontal"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Schließen"
                    HorizontalAlignment="Right"
                    MinWidth="110"
                    Click="Close_Click"
                    Padding="16,10"/>
        </Grid>
    </Grid>
</Window>
