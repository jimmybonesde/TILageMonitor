<Window x:Class="TILageMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="643"
        Height="756"
        MinWidth="555"
        MinHeight="630"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Einstellungen"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMain}"/>
            <TextBlock Text="Darstellung, Startverhalten, Updates und Benachrichtigungen"
                       FontSize="13"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Darstellung -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Darstellung" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Oberfläche der Anwendung"
                                   Style="{StaticResource SectionHintStyle}"/>
                        <CheckBox x:Name="DarkModeToggle"
                                  Content="Dunkelmodus"
                                  Style="{DynamicResource ToggleSwitchStyle}"
                                  Checked="DarkModeToggle_Changed"
                                  Unchecked="DarkModeToggle_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Start -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Start" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Beim Anmelden automatisch starten (mit --tray)"
                                   Style="{StaticResource SectionHintStyle}"/>
                        <CheckBox x:Name="AutoStartToggle"
                                  Content="Autostart"
                                  Style="{DynamicResource ToggleSwitchStyle}"
                                  Checked="AutoStartToggle_Changed"
                                  Unchecked="AutoStartToggle_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Updates -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Beim Start wird automatisch nach einer neuen Version gesucht."
                                   Style="{StaticResource SectionHintStyle}"/>
                        <TextBlock x:Name="UpdateStatusText"
                                   Text="Aktuelle Version wird beim Start automatisch geprüft."
                                   Style="{StaticResource SectionHintStyle}"
                                   Margin="0,0,0,10"/>
                        <Button x:Name="CheckForUpdatesButton"
                                Content="Nach Updates suchen"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="16,9"
                                Click="CheckForUpdates_Click"/>
                    </StackPanel>
                </Border>

                <!-- Benachrichtigungen -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.11" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Benachrichtigungen" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Text="Toast-Meldungen pro Dienst (Tray-Icon-Farbe bleibt unverändert)"
                                   Style="{StaticResource SectionHintStyle}"/>
                        <WrapPanel x:Name="NotifyServicesPanel" Orientation="Horizontal"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Schließen"
                    HorizontalAlignment="Right"
                    MinWidth="110"
                    Click="Close_Click"
                    Padding="16,10"/>
        </Grid>
    </Grid>
</Window>
