<Window x:Class="TILageMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Width="510"
        Height="650"
        MinWidth="440"
        MinHeight="552"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Einstellungen"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMain}"/>
            <TextBlock Text="Darstellung, Startverhalten und Benachrichtigungen"
                       FontSize="13"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Darstellung -->
                <TextBlock Text="Darstellung" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Text="Oberfläche der Anwendung"
                           Style="{StaticResource SectionHintStyle}"/>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <CheckBox x:Name="DarkModeToggle"
                              Content="Dunkelmodus"
                              Style="{DynamicResource ToggleSwitchStyle}"
                              Checked="DarkModeToggle_Changed"
                              Unchecked="DarkModeToggle_Changed"/>
                </Border>

                <!-- Start -->
                <TextBlock Text="Start" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Text="Beim Anmelden automatisch starten (mit --tray)"
                           Style="{StaticResource SectionHintStyle}"/>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <CheckBox x:Name="AutoStartToggle"
                              Content="Autostart"
                              Style="{DynamicResource ToggleSwitchStyle}"
                              Checked="AutoStartToggle_Changed"
                              Unchecked="AutoStartToggle_Changed"/>
                </Border>

                <!-- Benachrichtigungen -->
                <TextBlock Text="Benachrichtigungen" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Text="Toast-Meldungen pro Dienst (Tray-Icon-Farbe bleibt unverändert)"
                           Style="{StaticResource SectionHintStyle}"/>
                <Border Style="{StaticResource SettingsCardStyle}">
                    <WrapPanel x:Name="NotifyServicesPanel" Orientation="Horizontal"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Schließen"
                    HorizontalAlignment="Right"
                    MinWidth="110"
                    Click="Close_Click"
                    Padding="16,10"/>
        </Grid>
    </Grid>
</Window>
