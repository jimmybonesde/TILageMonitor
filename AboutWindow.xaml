<Window x:Class="TILageMonitor.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über TI-Lage Monitor"
        Width="440"
        SizeToContent="Height"
        MinWidth="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="AboutCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="BulletStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="AboutLinkStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentButtonBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: logo + title -->
        <Border Grid.Row="0" Style="{StaticResource AboutCardStyle}">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="80" Height="80" CornerRadius="20"
                        Background="{DynamicResource AppIconCircleBackground}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <Image Source="pack://application:,,,/docs/assets/app-icon-128.png"
                           Width="80" Height="80"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="Fant"/>
                </Border>
                <TextBlock Text="TI-Lage Monitor"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="VersionText"
                           FontSize="13"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
                <TextBlock Text="Autor: Randy Carter / R.C.  ·  © 2026"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Grid.Row="1" Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <TextBlock Text="Funktionen"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource BulletStyle}" Text="• Ampel-Status im Infobereich (Systemtray)"/>
                <TextBlock Style="{StaticResource BulletStyle}" Text="• Windows-Toasts bei Störungen und Statuswechseln"/>
                <TextBlock Style="{StaticResource BulletStyle}" Text="• 14-Tage-Verlauf mit Tages-Kacheln und Ereignisse-Timeline"/>
                <TextBlock Style="{StaticResource BulletStyle}" Text="• Offline-Cache bei API-Ausfall"/>
                <TextBlock Style="{StaticResource BulletStyle}" Text="• Autostart, Dunkelmodus, Benachrichtigungsfilter"/>
            </StackPanel>
        </Border>

        <!-- Contact -->
        <Border Grid.Row="2" Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <TextBlock Text="Kontakt / Support"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,6"/>
                <TextBlock FontSize="12.5"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"
                           Text="Fragen oder Feedback zur Community-App?"/>
                <Button Content="www.jimmybones.de"
                        Style="{StaticResource AboutLinkStyle}"
                        Click="OpenHomepage_Click"
                        ToolTip="Homepage öffnen"/>
                <Button Content="Webmaster@JimmyBones.de"
                        Style="{StaticResource AboutLinkStyle}"
                        Click="OpenEmail_Click"
                        ToolTip="E-Mail schreiben"/>
            </StackPanel>
        </Border>

        <!-- Disclaimer + link -->
        <Border Grid.Row="3" Style="{StaticResource AboutCardStyle}">
            <StackPanel>
                <TextBlock Text="Hinweis"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,6"/>
                <TextBlock FontSize="12.5"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"
                           Text="Kein offizielles Produkt der gematik GmbH. Datenquelle ist die öffentliche TI-Lage-API. Angaben ohne Gewähr."/>
                <Button Content="gematik Fachportal · TI-Status öffnen"
                        Style="{DynamicResource AccentButtonStyle}"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Stretch"
                        Click="OpenFachportal_Click"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="4"
                Content="Schließen"
                HorizontalAlignment="Right"
                MinWidth="110"
                Padding="16,10"
                Click="Close_Click"/>
    </Grid>
</Window>
