<Window x:Class="TILageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TI-Lage Monitor"
        Width="900"
        Height="760"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="TI-Lage Monitor"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"/>

                <TextBlock Text="Live-Überwachung der gematik TI-Lage · Toast-Benachrichtigungen bei Änderungen"
                           FontSize="13"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>

            </StackPanel>


            <!-- Settings + Actions -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button x:Name="HistoryButton"
                        Content="📈  Verlauf"
                        Click="History_Click"
                        Margin="0,0,10,0"
                        ToolTip="TI-Status · 7 Tage"/>

                <Button x:Name="SettingsButton"
                        Content="⚙  Einstellungen"
                        Click="Settings_Click"
                        Margin="0,0,10,0"
                        ToolTip="Einstellungen öffnen"/>

                <Button x:Name="RefreshButton"
                        Content="↻  Jetzt aktualisieren"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Refresh_Click"
                        Margin="0,0,10,0"/>

                <Button Content="gematik öffnen"
                        Click="OpenGematik_Click"/>

            </StackPanel>

        </Grid>


        <!-- ===================================================== -->
        <!-- GESAMTSTATUS (Hero Card) -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22"
                Margin="0,0,0,18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18"
                                  ShadowDepth="2"
                                  Opacity="0.14"
                                  Direction="270"
                                  Color="#000000"/>
            </Border.Effect>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- Statuspunkt -->

                <Border Width="52"
                        Height="52"
                        CornerRadius="26"
                        Background="{DynamicResource ChipBackground}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                    <TextBlock x:Name="OverallIcon"
                               Text="●"
                               FontSize="30"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- Statusinformationen -->

                <StackPanel Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Gesamtstatus"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}"/>

                    <TextBlock x:Name="OverallText"
                               Text="Wird geladen …"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"
                               Margin="0,4,0,0"/>

                    <TextBlock x:Name="TimestampText"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,6,0,0"/>

                </StackPanel>


                <!-- API Status -->

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">

                    <TextBlock Text="Verbindung"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               HorizontalAlignment="Right"/>

                    <TextBlock x:Name="ConnectionText"
                               Text="● Prüfe API …"
                               FontSize="12"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextMuted}"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- INHALT -->
        <!-- ===================================================== -->

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>


                <!-- ================================================= -->
                <!-- TI ANWENDUNGEN -->
                <!-- ================================================= -->

                <Grid Margin="0,0,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>

                        <TextBlock Text="TI-Anwendungen"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"/>

                        <TextBlock Text="Aktueller Status der zentralen TI-Dienste"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>


                <ItemsControl x:Name="AppsList">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Style="{StaticResource CardStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- Statuspunkt -->

                                    <Border Width="18"
                                            Height="18"
                                            CornerRadius="9"
                                            Background="{DynamicResource ChipBackground}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">

                                        <TextBlock Text="●"
                                                   FontSize="18"
                                                   Foreground="{Binding StatusBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-1,0,0"/>

                                    </Border>


                                    <!-- Name -->

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMain}"/>

                                    </StackPanel>


                                    <!-- Status -->

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Detail}"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMuted}"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>


                <!-- ================================================= -->
                <!-- MELDUNGEN -->
                <!-- ================================================= -->

                <StackPanel Margin="0,12,0,10">

                    <TextBlock Text="Aktuelle Meldungen"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"/>

                    <TextBlock Text="Störungen, Einschränkungen und erkannte Ursachen"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <ItemsControl x:Name="MessagesList">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Style="{StaticResource CardStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <Border Width="32"
                                            Height="32"
                                            CornerRadius="16"
                                            Background="{DynamicResource MessageChipBackground}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top">

                                        <TextBlock Text="!"
                                                   FontWeight="Bold"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource MessageChipForeground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>


                                    <StackPanel Grid.Column="1"
                                                Margin="14,0,0,0">

                                        <TextBlock Text="{Binding Header}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMain}"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="{Binding Body}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>


                <!-- Keine Meldungen -->

                <Border x:Name="NoMessagesBorder"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">

                    <StackPanel HorizontalAlignment="Center">

                        <TextBlock Text="✓"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource StatusOk}"/>

                        <TextBlock Text="Keine aktuellen Meldungen"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMain}"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Aktuell liegen keine Störungen oder Einschränkungen vor."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,3,0,0"/>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- ===================================================== -->
        <!-- FOOTER -->
        <!-- ===================================================== -->

        <Grid Grid.Row="3"
              Margin="0,16,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- technische Informationen -->

            <Grid Grid.Row="0">

                <TextBlock x:Name="FooterText"
                           FontSize="11"
                           Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center"/>

            </Grid>


            <!-- Copyright -->

            <TextBlock Grid.Row="1"
                       Text="© 2026 R.C. · TI-Lage Monitor"
                       FontSize="10"
                       Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Opacity="0.75"/>

        </Grid>

    </Grid>

</Window>
