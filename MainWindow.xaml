<Window x:Class="TILageMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TI-Lage Monitor"
        Width="920"
        Height="780"
        MinWidth="760"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="22,18"
                Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" Direction="270" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AppIconCircleBackground}" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Viewbox Width="26" Height="26" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource AppIconForeground}" Data="M3,4 H21 A1.5,1.5 0 0 1 22.5,5.5 V14.5 A1.5,1.5 0 0 1 21,16 H13.2 L14,19 H16 V20.5 H8 V19 H10 L10.8,16 H3 A1.5,1.5 0 0 1 1.5,14.5 V5.5 A1.5,1.5 0 0 1 3,4 Z M4.5,6 V13.5 H19.5 V6 H4.5 Z"/>
                                <Path Stroke="{DynamicResource AppIconForeground}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6.5,10.2 L8.8,12.2 L12.2,7.8 L14.5,10 L17.2,8.2"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TI-Lage Monitor" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                        <TextBlock Text="Überwachung der Telematikinfrastruktur und zentraler TI-Dienste." FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="↻  Aktualisieren" Click="Refresh_Click" Margin="0,0,8,0" ToolTip="Jetzt aktualisieren"/>
                    <Button x:Name="HistoryButton" Content="📈  Verlauf" Click="History_Click" Margin="0,0,8,0" ToolTip="TI-Status · 7 Tage"/>
                    <Button x:Name="SettingsButton" Content="⚙  Einstellungen" Click="Settings_Click" ToolTip="Einstellungen öffnen"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="OverallStatusCard" Grid.Row="1" Background="{DynamicResource StatusOkSurface}" BorderBrush="{DynamicResource StatusOkBorder}" BorderThickness="1" CornerRadius="16" Padding="22" Margin="0,0,0,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" Direction="270" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="OverallIconCircle" Width="56" Height="56" CornerRadius="28" Background="{DynamicResource StatusOk}" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock x:Name="OverallIcon" Text="✓" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="OverallText" Text="Wird geladen …" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                    <TextBlock x:Name="OverallSubtitle" Text="Status wird ermittelt…" FontSize="14" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TimestampText" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0" Opacity="0.9"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <TextBlock Text="Verbindung" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="ConnectionText" Text="● Prüfe API …" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Right" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,16">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.10" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Dienste" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,14"/>
                        <ItemsControl x:Name="AppsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBrush}" CornerRadius="18" Padding="14,8" Margin="0,0,10,10" ToolTip="{Binding Detail}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="20" Margin="0,0,0,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.10" Direction="270" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Aktuelle Meldungen" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,14"/>
                        <ItemsControl x:Name="MessagesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ChipBackground}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource MessageChipBackground}" VerticalAlignment="Top">
                                                <TextBlock Text="!" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource MessageChipForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                                <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Body}" FontSize="13" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="NoMessagesBorder" Background="{DynamicResource ChipBackground}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="22" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="✓" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource StatusOk}"/>
                                <TextBlock Text="Keine aktuellen Meldungen" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextMain}" Margin="0,6,0,0"/>
                                <TextBlock Text="Aktuell liegen keine Störungen oder Einschränkungen vor." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="© 2026 R.C. · TI-Lage Monitor" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
            <Button Grid.Column="2" Content="gematik" Click="OpenGematik_Click" HorizontalAlignment="Right" Padding="10,5" FontSize="11" Opacity="0.85" ToolTip="gematik TI-Status öffnen"/>
        </Grid>
    </Grid>
</Window>
